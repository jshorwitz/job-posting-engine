<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-body background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      p { margin: 0 0 12px 0; }
      a { color: #1a73e8; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff" width="560px">
    <mj-section padding="32px 16px 16px">
      <mj-column>
        <mj-text font-size="14px" line-height="24px" color="#1a1a1a">
          {emailBody}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 16px 0">
      <mj-column>
        <mj-divider border-color="#e8e8e8" border-width="1px" padding="0 0 12px" />
        <mj-text font-size="13px" line-height="20px" color="#555555">
          Joel Horwitz<br/>
          <span style="color: #888888;">Synter Media · syntermedia.ai</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px 16px 24px">
      <mj-column>
        <mj-text font-size="11px" color="#aaaaaa" align="center">
          <a href="{unsubscribe_link}" style="color: #aaaaaa; text-decoration: underline;">Unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
