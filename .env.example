# ============================================================
# Job Posting Growth Engine — Environment Configuration
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- Sumble API (https://sumble.com/account/api-keys) ---
SUMBLE_API_KEY=your_sumble_api_key_here

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Hunter.io (email enrichment — https://hunter.io/api-documentation) ---
HUNTER_API_KEY=your_hunter_api_key_here

# --- Loops.so (email sending — https://loops.so/docs/api-reference) ---
LOOPS_API_KEY=your_loops_api_key_here
LOOPS_TRANSACTIONAL_ID=  # deprecated — kept for backwards compat
LOOPS_MAILING_LIST_ID=   # Required: copy from Loops → Audience → Lists → your list → Settings

# --- Sender identity (used in AI-generated messages) ---
SENDER_NAME=Your First Name
COMPANY_NAME=Your Company
COMPANY_PITCH=helps companies do X faster than doing it in-house

# --- SMTP (fallback — only used if Loops not configured) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key
FROM_EMAIL=you@yourdomain.com
FROM_NAME=Your Name

# --- Slack (optional — leave blank to disable) ---
SLACK_WEBHOOK_URL=

# --- LinkedIn Sales Navigator ---
# Session dir stores browser cookies (login once, reuse)
LINKEDIN_SESSION_DIR=data/linkedin-session
LINKEDIN_HEADLESS=false
LINKEDIN_MIN_DELAY=30
LINKEDIN_MAX_DELAY=90
LINKEDIN_DAILY_LIMIT=25
LINKEDIN_OUTREACH_TYPE=inmail  # "inmail" or "connection"

# --- SpyFu (competitive PPC/SEO intelligence — https://developer.spyfu.com) ---
# Keys are managed in Doppler (synter-media project, prd config)
SPYFU_API_ID=your_spyfu_api_id_here
SPYFU_SECRET_KEY=your_spyfu_secret_key_here
SPYFU_ENRICH_AFTER_DAYS=1  # Enrich contacts N days after initial send

# --- BuiltWith (tech stack / ad pixel detection — https://builtwith.com/api) ---
# Keys are managed in Doppler (synter-media project, prd config)
BUILTWITH_API_KEY=your_builtwith_api_key_here

# --- Firecrawl (homepage scraping — https://firecrawl.dev) ---
# Keys are managed in Doppler (synter-media project, prd config)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- Follow-up CTA ---
CALENDLY_URL=https://calendly.com/yourname/15min

# --- Behaviour ---
DRY_RUN=true
MAX_EMAILS_PER_RUN=20
OUTREACH_CHANNEL=linkedin  # "email", "linkedin", or "both"
JOB_QUERY=Head of Growth
JOB_TECHNOLOGIES=google-ads,facebook-ads,performance-marketing
JOB_COUNTRIES=US
JOB_SINCE_DAYS=30
LOG_LEVEL=INFO

# --- X (Twitter) Growth Engine ---
# OAuth 1.0a credentials for posting from @JSHorwitz
JOEL_X_CONSUMER_KEY=your_x_consumer_key
JOEL_X_CONSUMER_SECRET=your_x_consumer_secret
JOEL_X_ACCESS_TOKEN=your_x_access_token
JOEL_X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
# Bearer token for search (read-only)
X_API_BEARER_TOKEN=your_x_bearer_token
# Feature toggles
X_CONTENT_POSTER_ENABLED=true
X_ENGAGEMENT_SCANNER_ENABLED=true
X_LINKEDIN_CROSSPOST_ENABLED=true

# --- LinkedIn Org Posting (SynterAI page) ---
# Get tokens by running: python scripts/linkedin_auth.py
LINKEDIN_ACCESS_TOKEN=your_access_token
LINKEDIN_REFRESH_TOKEN=your_refresh_token
LINKEDIN_CLIENT_ID=86jcu6xeaod28m
LINKEDIN_CLIENT_SECRET=your_client_secret
# SynterAI org page
LINKEDIN_ORG_URN=urn:li:organization:4803356
